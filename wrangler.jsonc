{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // FastLane Mechanic — do not reuse White Widow Worker name or D1 id.
  "name": "fastlane-mechanic",
  "compatibility_date": "2026-08-20",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/inv"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fastlane-mechanic",
      // Placeholder for local `wrangler d1 migrations apply DB --local`.
      // Create a real D1 (`npx wrangler d1 create fastlane-mechanic`) before remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
